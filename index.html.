<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Massawe Phone Accessories</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f6f9;
            color: #172033;
        }

        header {
            background: #101827;
            color: white;
            padding: 24px 16px;
            text-align: center;
        }

        header h1 {
            margin: 0 0 10px;
            font-size: 28px;
        }

        nav {
            background: #202d42;
            padding: 14px;
            text-align: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 0 12px;
        }

        .hero {
            text-align: center;
            padding: 55px 20px;
            background: white;
        }

        .hero h2 {
            font-size: 32px;
        }

        .hero p {
            color: #596579;
            line-height: 1.7;
        }

        .button {
            display: inline-block;
            background: #087fda;
            color: white;
            padding: 13px 22px;
            text-decoration: none;
            border-radius: 7px;
            margin-top: 12px;
        }

        .products {
            padding: 35px 20px;
            text-align: center;
        }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 18px;
            max-width: 950px;
            margin: 25px auto;
        }

        .product {
            background: white;
            padding: 25px 15px;
            border-radius: 12px;
            box-shadow: 0 3px 12px #00000010;
        }

        .product .emoji {
            font-size: 45px;
        }

        footer {
            background: #101827;
            color: white;
            text-align: center;
            padding: 22px;
        }
    </style>
</head>
<body>

    <header>
        <h1>Massawe Phone Accessories</h1>
        <p>Your Trusted Phone Accessories Shop</p>
    </header>

    <nav>
        <a href="#home">Home</a>
        <a href="#products">Products</a>
        <a href="#contact">Contact</a>
    </nav>

    <section class="hero" id="home">
        <h2>Accessories for Your Phone</h2>
        <p>Discover phone cases, chargers, earphones and more.</p>
        <a href="#products" class="button">Explore Products</a>
    </section>

    <section class="products" id="products">
        <h2>Our Products</h2>

        <div class="product-grid">
            <div class="product">
                <div class="emoji">📱</div>
                <h3>Phone Cases</h3>
                <p>Stylish cases for your phone.</p>
            </div>

            <div class="product">
                <div class="emoji">🔌</div>
                <h3>Chargers</h3>
                <p>Charging accessories for everyday use.</p>
            </div>

            <div class="product">
                <div class="emoji">🎧</div>
                <h3>Earphones</h3>
                <p>Enjoy your favourite music.</p>
            </div>

            <div class="product">
                <div class="emoji">🔋</div>
                <h3>Power Banks</h3>
                <p>Portable power for your devices.</p>
            </div>
        </div>
    </section>

    <footer id="contact">
        <h2>Contact Us</h2>
        <p>Massawe Phone Accessories</p>
        <p>Get in touch with us to learn more about our products.</p>
        <p>&copy; 2026 Massawe Phone Accessories</p>
    </footer>

</body>
</html>
