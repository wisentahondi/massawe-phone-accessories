@app.route("/admin", methods=["GET", "POST"])
def admin():
    if request.method == "POST":
        if request.form.get("password") != ADMIN_PASSWORD:
            return render_template_string("""
            """ + PAGE_STYLE + """
            <main><h2>Admin Login</h2><p style="color:red">Wrong password.</p>
            <form method="post"><input type="password" name="password" placeholder="Admin password" required>
            <button>Log in</button></form></main>"""), 401

        action = request.form.get("action")
        products = load_products()

        if action == "add":
            name = request.form.get("name", "").strip()
            price = request.form.get("price", "").strip()
            description = request.form.get("description", "").strip()
            image_file = request.files.get("image")
            image_name = ""

            if name and price.isdigit():
                if image_file and image_file.filename:
                    ext = Path(secure_filename(image_file.filename)).suffix.lower()
                    if ext in {".jpg", ".jpeg", ".png", ".webp"}:
                        image_name = uuid.uuid4().hex + ext
                        image_file.save(UPLOAD_DIR / image_name)

                products.append({
                    "id": uuid.uuid4().hex,
                    "name": name,
                    "price": price,
                    "image": image_name,
                    "description": description
                })
                save_products(products)

        elif action == "update":
            product_id = request.form.get("id")
            for p in products:
                if p["id"] == product_id:
                    name = request.form.get("name", "").strip()
                    price = request.form.get("price", "").strip()
                    if name and price.isdigit():
                        p["name"] = name
                        p["price"] = price
                        p["description"] = request.form.get("description", "").strip()
                        image_file = request.files.get("image")
                        if image_file and image_file.filename:
                            ext = Path(secure_filename(image_file.filename)).suffix.lower()
                            if ext in {".jpg", ".jpeg", ".png", ".webp"}:
                                image_name = uuid.uuid4().hex + ext
                                image_file.save(UPLOAD_DIR / image_name)
                                p["image"] = image_name
                    break
            save_products(products)

        elif action == "delete":
            product_id = request.form.get("id")
            products = [p for p in products if p["id"] != product_id]
            save_products(products)

        return redirect(url_for("admin"))

    products = load_products()
    return render_template_string("""
    <!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1">
    """ + PAGE_STYLE + """</head><body><header><h1>Admin Panel</h1>
    <p>Massawe Phone Accessories</p></header><main>
    <h2>Log in</h2>
    <form method="post"><input type="password" name="password" placeholder="Admin password" required>
    <button>Open Admin Panel</button></form>
    <p>Default password: <b>change-me-123</b>. Change it before using this site beyond your own computer.</p>
    <hr><h2>Add a product</h2>
    <form method="post" enctype="multipart/form-data">
    <input type="hidden" name="password" value="change-me-123">
    <input type="hidden" name="action" value="add">
    <input name="name" placeholder="Product name" required>
    <input name="price" type="number" min="0" placeholder="Price in TSh" required>
    <textarea name="description" placeholder="Description"></textarea>
    <label>Product photo (JPG, PNG or WEBP)</label><input type="file" name="image" accept=".jpg,.jpeg,.png,.webp">
    <button>Add product</button></form>
    <h2>Edit or delete products</h2>
    {% for p in products %}
    <form method="post" enctype="multipart/form-data">
    <input type="hidden" name="password" value="change-me-123">
    <input type="hidden" name="id" value="{{ p.id }}">
    <input type="hidden" name="action" value="update">
    <input name="name" value="{{ p.name }}" required>
    <input name="price" type="number" min="0" value="{{ p.price }}" required>
    <textarea name="description">{{ p.description }}</textarea>
    <label>Replace photo (optional)</label><input type="file" name="image" accept=".jpg,.jpeg,.png,.webp">
    <button>Save changes</button></form>
    <form method="post" onsubmit="return confirm('Delete this product?')">
    <input type="hidden" name="password" value="change-me-123">
    <input type="hidden" name="id" value="{{ p.id }}">
    <input type="hidden" name="action" value="delete">
    <button class="delete">Delete {{ p.name }}</button></form>
    {% endfor %}
    <p><a href="/">View website</a></p></main></body></html>
    """, products=products)

if __name__ == "__main__":
    save_products(load_products())
    app.run(debug=False, host="127.0.0.1", port=5000)
