@app.route("/")
def home():
    products = load_products()
    return render_template_string("""
    <!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1">
    """ + PAGE_STYLE + """</head><body>
    <header class="hero">
    <h1>MASSAWE PHONE ACCESSORIES</h1>
