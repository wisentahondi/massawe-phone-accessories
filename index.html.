from flask import Flask, request, redirect, url_for, render_template_string
from werkzeug.utils import secure_filename
from pathlib import Path
import json
import os
import uuid

app = Flask(__name__)

BASE_DIR = Path(__file__).parent
UPLOAD_DIR = BASE_DIR / "static" / "uploads"
DATA_FILE = BASE_DIR / "products.json"

UPLOAD_DIR.mkdir(parents=True, exist_ok=True)

# Change this password before using the admin panel.
ADMIN_PASSWORD = os.environ.get("MASSAWE_ADMIN_PASSWORD", "change-me-123")

def load_products():
    if DATA_FILE.exists():
        try:
            return json.loads(DATA_FILE.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError):
            pass
    return [
        {"id": "1", "name": "Phone Covers", "price": "5000", "image": "", "description": "Phone covers"},
        {"id": "2", "name": "Chargers", "price": "10000", "image": "", "description": "Phone chargers"},
        {"id": "3", "name": "Earphones", "price": "7000", "image": "", "description": "Quality earphones"},
    ]

def save_products(products):
    DATA_FILE.write_text(
        json.dumps(products, ensure_ascii=False, indent=2),
        encoding="utf-8"
    )

